{
  "name": "neo-cmd",
  "version": "0.1.2",
  "description": "Neo CMD - terminal com abas estilo navegador e Claude Code integrado",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 nsis"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.325",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.tgui.neocmd",
    "productName": "Neo CMD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "node_modules/**",
      "!node_modules/@anthropic-ai/claude-code-linux*/**",
      "!node_modules/@lydell/node-pty-linux*/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@anthropic-ai/claude-code/bin/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/@anthropic-ai/**"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neo CMD",
      "differentialPackage": false,
      "artifactName": "NeoCMD-Setup-${version}.exe"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  },
  "author": "TGuiDev"
}
